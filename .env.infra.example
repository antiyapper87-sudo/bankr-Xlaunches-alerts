APP_ENV=production

# Use Postgres for service/staging/prod. The local docker-compose credentials are dev-only.
DATABASE_URL=postgresql+asyncpg://bankr:bankr@localhost:5432/bankr_alerts
DATABASE_AUTO_CREATE=false

# Redis/RQ
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=launches

# Runtime process sizing
MAX_ENRICHMENT_CONCURRENCY=8
MAX_VERDICT_CONCURRENCY=4
MAX_DELIVERY_CONCURRENCY=20
TELEGRAM_RETRY_BATCH=20
TELEGRAM_MAX_DELIVERY_ATTEMPTS=3
