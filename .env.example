# Runtime
APP_ENV=local

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTHORIZED_USER_IDS=544999608

# SocialData
SOCIALDATA_API_KEY=

# Database
# Local dev defaults to SQLite. Production should use DATABASE_URL with Postgres.
LOCAL_DATABASE_URL=sqlite+aiosqlite:///data/bot.db
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/bankr_alerts
DATABASE_AUTO_CREATE=true

# Redis / queue
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=launches

# DexScreener discovery source
DEXSCREENER_DISCOVERY_ENABLED=true
DEXSCREENER_DISCOVERY_LIMIT=40

# Tenant defaults
DEFAULT_TENANT_ID=default
DEFAULT_MIN_SCORE=6.0
FREE_DAILY_SIGNAL_LIMIT=10

# Concurrency
MAX_ENRICHMENT_CONCURRENCY=8
MAX_VERDICT_CONCURRENCY=4
MAX_DELIVERY_CONCURRENCY=20
TELEGRAM_RETRY_BATCH=20
TELEGRAM_MAX_DELIVERY_ATTEMPTS=3

# Feature flags
AUTO_VERDICT_ENABLED=true
TRADING_ENABLED=false
ALLOW_UNSAFE_TRADING=false
DYNAMIC_THRESHOLDS_ENABLED=false
LLM_SCORING_ENABLED=false
