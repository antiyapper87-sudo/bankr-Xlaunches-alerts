# Runtime
APP_ENV=local

# Telegram
TELEGRAM_BOT_TOKEN=
# Optional default group/chat tenant. Public DM users subscribe with /start.
TELEGRAM_CHAT_ID=
AUTHORIZED_USER_IDS=544999608
ADMIN_USER_ID=544999608
TELEGRAM_COMMAND_POLL_INTERVAL=0.5
TELEGRAM_GET_UPDATES_TIMEOUT=1
TELEGRAM_GET_UPDATES_LIMIT=25
TELEGRAM_BACKGROUND_COMMAND_LIMIT=8

# SocialData
SOCIALDATA_API_KEY=
SOCIALDATA_SEARCH_MAX_PAGES=4
SOCIALDATA_SEARCH_CACHE_TTL_SEC=900
SOCIALDATA_SEARCH_EMPTY_CACHE_TTL_SEC=300
SOCIALDATA_SEARCH_STALE_TTL_SEC=86400
SOCIALDATA_SEARCH_MAX_CALLS_PER_MIN=30
SOCIALDATA_SEARCH_MAX_CALLS_PER_HOUR=240
RESEARCH_MIN_QUALIFIED_TWEETS=5
RESEARCH_MIN_TWEET_VIEWS=50
RESEARCH_MIN_TWEET_LIKES=5
RESEARCH_MIN_FOLLOWERS=1000
REQUIRE_CA_SOCIAL_CONFIRMATION=true
RESEARCH_HIGH_SIGNAL_SCORE=8
NITTER_ENABLED=false
NITTER_BASE_URLS=http://127.0.0.1:18080
NITTER_HEALTH_ENABLED=true
NITTER_HEALTH_INTERVAL_SEC=300
NITTER_HEALTH_QUERY=$GSPEED

# Fomo App integration. Store real cookie export only in ignored .secrets/.
FOMO_ENABLED=false
FOMO_API_BASE=https://prod-api.fomo.family
FOMO_COOKIES_FILE=.secrets/fomo_cookies.json
FOMO_SUPPORTED_CHAINS=56,143,8453,1399811149
FOMO_DEFAULT_CHAIN_ID=8453

# Database
# Local dev defaults to SQLite. Production should use DATABASE_URL with Postgres.
LOCAL_DATABASE_URL=sqlite+aiosqlite:///data/bot.db
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/bankr_alerts
DATABASE_AUTO_CREATE=true

# Redis / queue
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=launches

# DexScreener discovery source
DEXSCREENER_DISCOVERY_ENABLED=true
DEXSCREENER_DISCOVERY_LIMIT=40

# CoinGecko Onchain Base new-pools discovery
# Keep interval conservative: 720s is 5 calls/hour, about 3.6k calls/month.
COINGECKO_API_KEY=
COINGECKO_DISCOVERY_ENABLED=false
COINGECKO_DISCOVERY_LIMIT=25
COINGECKO_POLL_INTERVAL=720
COINGECKO_RATE_LIMIT_PER_MIN=12
COINGECKO_COOLDOWN_SEC=120

# Base RPC for wallet monitoring and on-chain launch risk scans.
ALCHEMY_RPC_URL=
BLOCK_READER_QUICK_MAX_BLOCKS=140
BLOCK_READER_GET_LOGS_CHUNK_BLOCKS=10
BLOCK_READER_MAX_LOGS_PER_SCAN=5000
BLOCK_READER_RPC_MAX_CONCURRENCY=3
BLOCK_READER_RPC_TIMEOUT_SEC=10
BLOCK_READER_RPC_RETRIES=1
BLOCK_READER_BALANCE_BATCH_SIZE=20
BLOCK_READER_MAX_FIRST_BUYERS=40

# Tenant defaults
DEFAULT_TENANT_ID=default
DEFAULT_MIN_SCORE=6.0
FREE_DAILY_SIGNAL_LIMIT=10

# Concurrency
MAX_ENRICHMENT_CONCURRENCY=8
MAX_VERDICT_CONCURRENCY=4
MAX_DELIVERY_CONCURRENCY=20
TELEGRAM_RETRY_BATCH=20
TELEGRAM_MAX_DELIVERY_ATTEMPTS=3
TELEGRAM_SIGNAL_DELIVERY_LIMIT=2000
WATCHLIST_CHECK_INTERVAL=900
WATCHLIST_CHECK_BATCH=100
WATCHLIST_NOTIFY_MCAP_CHANGE_PCT=50
WATCHLIST_NOTIFY_VOLUME_CHANGE_PCT=100
WATCHLIST_PAGE_SIZE=10
WATCHLIST_RECENT_HOURS=24
WATCHLIST_STALE_HOURS=6
WALLET_MONITOR_ENABLED=false
WALLET_POLL_INTERVAL=60
WALLET_POLL_BATCH=50
WALLET_LOOKBACK_BLOCKS=1200
WALLET_EVENT_RECENT_MINUTES=60

# Feature flags
AUTO_VERDICT_ENABLED=true
SAME_TICKER_EXTERNAL_ENABLED=true
SAME_TICKER_PRIOR_LOOKBACK_HOURS=48
SAME_TICKER_EXTERNAL_TIMEOUT_SEC=8
DYNAMIC_THRESHOLDS_ENABLED=false
LLM_SCORING_ENABLED=false
